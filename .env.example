# Dexcom Share credentials (the account that owns the CGM, or a follower's login).
# Share must be enabled in the Dexcom app with at least one follower.
DEXCOM_USERNAME=you@example.com
DEXCOM_PASSWORD=change-me
# Optional: use instead of username (UUID shown in some Dexcom account pages)
# DEXCOM_ACCOUNT_ID=

# us = United States, ous = outside US, jp = Japan
DEXCOM_REGION=us

# mg/dL (default) or mmol/L
DEXCOM_UNITS=mg/dL

# Target range for stats, always in mg/dL
DEXCOM_TARGET_LOW=70
DEXCOM_TARGET_HIGH=180

# Set to 1 to serve synthetic data without touching Dexcom (for testing the wiring)
DEXCOM_DRY_RUN=0
